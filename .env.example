# Vorlage für den optionalen KI-Assistenten im Workflow-Planer.
# Kopieren nach ".env" (gleicher Ordner) und EINE der Varianten aktivieren. Die .env wird nie angezeigt oder übertragen.

# --- Variante A: auf eine vorhandene Datei verweisen (Schlüssel wird nicht kopiert) ---
# AEAP_LLM_API_KEY_FILE=C:\Users\<name>\secrets\llm.env
# AEAP_LLM_API_KEY_VAR=MOONSHOT_API_KEY

# --- Variante B: Schlüssel direkt eintragen (nur einer nötig) ---
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional ---
# AEAP_LLM_MODEL=            # leer = automatische Auswahl über /models
# AEAP_LLM_BASE_URL=         # z. B. https://api.moonshot.cn/v1 für Schlüssel der chinesischen Kimi-Plattform
# AEAP_LLM_PROVIDER=         # moonshot | openai | deepseek | openrouter | custom
